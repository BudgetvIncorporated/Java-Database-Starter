# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local
java-database-starter/library-recovery/
java-database-starter/*.db*
java-database-starter/.library-stage-*/
java-database-starter/*.recovery-lock/

# Never include uploaded database backups in a published image.
attached_assets/**/*.db*
attached_assets/**/*.sqlite*
